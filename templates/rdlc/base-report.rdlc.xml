<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="{{DataSourceName}}">
      <ConnectionProperties>
        <DataProvider>System.Data.DataSet</DataProvider>
        <ConnectString>/* Local Connection */</ConnectString>
      </ConnectionProperties>
      <rd:DataSourceID>{{DataSourceId}}</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    {{DataSetsXml}}
  </DataSets>
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          {{TablixItemsXml}}
        </ReportItems>
        <Height>{{BodyHeightIn}}in</Height>
        <Style />
      </Body>
      <Width>{{BodyWidthIn}}in</Width>
      <Page>
        <PageHeight>{{PageHeightIn}}in</PageHeight>
        <PageWidth>{{PageWidthIn}}in</PageWidth>
        <LeftMargin>{{LeftMarginIn}}in</LeftMargin>
        <RightMargin>{{RightMarginIn}}in</RightMargin>
        <TopMargin>{{TopMarginIn}}in</TopMargin>
        <BottomMargin>{{BottomMarginIn}}in</BottomMargin>
        <Style />
      </Page>
    </ReportSection>
  </ReportSections>
  <ReportParameters>
    {{ReportParametersXml}}
  </ReportParameters>
  <Code>{{EmbeddedVbCode}}</Code>
  <rd:ReportUnitType>Inch</rd:ReportUnitType>
  <rd:ReportID>{{ReportId}}</rd:ReportID>
</Report>
