uns></Paragraph><Paragraph><Style><LeftIndent>1.52cm</LeftIndent><HangingIndent>-0.34cm</HangingIndent><SpaceAfter>1pt</SpaceAfter><LineHeight>8.8pt</LineHeight></Style><TextRuns><TextRun><Value>•	</Value><Style><FontFamily>Calibri</FontFamily><FontSize>7pt</FontSize><Color>#2C2E35</Color></Style></TextRun><TextRun><Value>Batu pada saluran empedu;</Value><Style><FontFamily>Calibri</FontFamily><FontSize>7pt</FontSize><Color>#2C2E35</Color></Style></TextRun></TextRuns></Paragraph><Paragraph><Style><LeftIndent>1.52cm</LeftIndent><HangingIndent>-0.34cm</HangingIndent><SpaceAfter>1pt</SpaceAfter><LineHeight>8.8pt</LineHeight></Style><TextRuns><TextRun><Value>•	</Value><Style><FontFamily>Calibri</FontFamily><FontSize>7pt</FontSize><Color>#2C2E35</Color></Style></TextRun><TextRun><Value>Batu pada ginjal, saluran kemih, dan kandung kemih;</Value><Style><FontFamily>Calibri</FontFamily><FontSize>7pt</FontSize><Color>#2C2E35</Color></Style></TextRun></TextRuns></Paragraph><Paragraph><Style><LeftIndent>1.52cm</LeftIndent><HangingIndent>-0.34cm</HangingIndent><SpaceAfter>1pt</SpaceAfter><LineHeight>8.8pt</LineHeight></Style><TextRuns><TextRun><Value>•	</Value><Style><FontFamily>Calibri</FontFamily><FontSize>7pt</FontSize><Color>#2C2E35</Color></Style></TextRun><TextRun><Value>Katarak;</Value><Style><FontFamily>Calibri</FontFamily><FontSize>7pt</FontSize><Color>#2C2E35</Color></Style></TextRun></TextRuns></Paragraph><Paragraph><Style><LeftIndent>1.52cm</LeftIndent><HangingIndent>-0.34cm</HangingIndent><SpaceAfter>1pt</SpaceAfter><LineHeight>8.8pt</LineHeight></Style><TextRuns><TextRun><Value>•	</Value><Style><FontFamily>Calibri</FontFamily><FontSize>7pt</FontSize><Color>#2C2E35</Color></Style></TextRun><TextRun><Value>Ulkus pada lambung atau usus dua belas jari;</Value><Style><FontFamily>Calibri</FontFamily><FontSize>7pt</FontSize><Color>#2C2E35</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs>
