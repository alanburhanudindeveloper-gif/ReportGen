  <Paragraphs><Paragraph><Style><SpaceAfter>2pt</SpaceAfter></Style><TextRuns><TextRun><Value>Risiko Produk</Value><Style><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight><Color>#2C2E35</Color></Style></TextRun></TextRuns></Paragraph><Paragraph><Style><LineHeight>9.5pt</LineHeight></Style><TextRuns><TextRun><Value>Informasi mengenai risiko produk Asuransi Tambahan ini mengacu pada risiko Asuransi Dasar.</Value><Style><FontFamily>Calibri</FontFamily><FontSize>7pt</FontSize><Color>#2C2E35</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs>
  <Top>8.42cm</Top>
