  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="RIPLAYDataSource">
      <ConnectionProperties>
        <DataProvider>System.Data.DataSet</DataProvider>
        <ConnectString>/* Local Connection */</ConnectString>
      </ConnectionProperties>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="RIPLAYDataSet">
      <Query>
        <DataSourceName>RIPLAYDataSource</DataSourceName>
        <CommandText>/* Local DataSet */</CommandText>
      </Query>
      <Fields>
        <Field Name="ProductCode"><DataField>ProductCode</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="CustomerName"><DataField>CustomerName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="PlanUnits"><DataField>PlanUnits</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportParameters>
<ReportParameter Name="CustomerName">
  <DataType>String</DataType>
  <DefaultValue><Values><Value>Bapak Rony</Value></Values></DefaultValue>
  <Prompt>CustomerName</Prompt>
</ReportParameter>
<ReportParameter Name="CustomerAge">
  <DataType>String</DataType>
  <DefaultValue><Values><Value>40 Tahun</Value></Values></DefaultValue>
  <Prompt>CustomerAge</Prompt>
</ReportParameter>
<ReportParameter Name="CustomerGender">
  <DataType>String</DataType>
  <DefaultValue><Values><Value>Pria</Value></Values></DefaultValue>
  <Prompt>CustomerGender</Prompt>
</ReportParameter>
<ReportParameter Name="SelectedPlanUnits">
  <DataType>String</DataType>
  <DefaultValue><Values><Value>5 Unit (= Rp500.000,-)</Value></Values></DefaultValue>
  <Prompt>SelectedPlanUnits</Prompt>
</ReportParameter>
<ReportParameter Name="MonthlyInsuranceCost">
  <DataType>String</DataType>
  <DefaultValue><Values><Value>Rp84.167,-</Value></Values></DefaultValue>
  <Prompt>MonthlyInsuranceCost</Prompt>
</ReportParameter>
<ReportParameter Name="PolicyEffectiveDate">
  <DataType>String</DataType>
  <DefaultValue><Values><Value>2 Januari 2016</Value></Values></DefaultValue>
  <Prompt>PolicyEffectiveDate</Prompt>
</ReportParameter>
<ReportParameter Name="BenefitInpatientIllness">
  <DataType>String</DataType>
  <DefaultValue><Values><Value>Rp500.000,- per hari</Value></Values></DefaultValue>
  <Prompt>BenefitInpatientIllness</Prompt>
</ReportParameter>
<ReportParameter Name="BenefitInpatientAccident">
  <DataType>String</DataType>
  <DefaultValue><Values><Value>Rp1.000.000,- per hari</Value></Values></DefaultValue>
  <Prompt>BenefitInpatientAccident</Prompt>
</ReportParameter>
<ReportParameter Name="BenefitIcu">
  <DataType>String</DataType>
  <DefaultValue><Values><Value>Rp1.000.000,- per hari</Value></Values></DefaultValue>
  <Prompt>BenefitIcu</Prompt>
</ReportParameter>
<ReportParameter Name="BenefitSurgeryIllness">
  <DataType>String</DataType>
  <DefaultValue><Values><Value>Rp5.000.000,- per Ketidakmampuan</Value></Values></DefaultValue>
  <Prompt>BenefitSurgeryIllness</Prompt>
</ReportParameter>
<ReportParameter Name="BenefitSurgeryAccident">
  <DataType>String</DataType>
  <DefaultValue><Values><Value>Rp10.000.000,- per Ketidakmampuan</Value></Values></DefaultValue>
  <Prompt>BenefitSurgeryAccident</Prompt>
</ReportParameter>
<ReportParameter Name="BenefitFastRecovery">
  <DataType>String</DataType>
  <DefaultValue><Values><Value>Rp1.500.000,- per Ketidakmampuan</Value></Values></DefaultValue>
  <Prompt>BenefitFastRecovery</Prompt>
</ReportParameter>
