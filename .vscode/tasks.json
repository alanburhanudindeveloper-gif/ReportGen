{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ReportGen: List Agent Tools (Read-Only)",
      "type": "shell",
      "command": "npm run proposal-cli -- tools",
      "problemMatcher": []
    },
    {
      "label": "ReportGen: Scan Sample Proposal Project (Deterministic)",
      "type": "shell",
      "command": "npx tsx src/cli/proposalCli.ts scan --project samples/SampleProposalProject",
      "problemMatcher": []
    },
    {
      "label": "ReportGen: Build Deterministic Product Catalog",
      "type": "shell",
      "command": "npx tsx src/cli/proposalCli.ts catalog --project samples/SampleProposalProject",
      "problemMatcher": []
    },
    {
      "label": "ReportGen: Typecheck & Build",
      "type": "shell",
      "command": "npm run lint && npm run build",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "ReportGen: Run Offline Verification Suite",
      "type": "shell",
      "command": "npx tsx tests/run-agent-contract-tests.ts && npx tsx tests/run-e2e-tests.ts && npx tsx tests/run-proposal-e2e.ts",
      "problemMatcher": []
    }
  ]
}
