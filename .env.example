# Provider-agnostic LLM configuration (no secrets committed).
# Supported providers: gemini | openai | openai-compatible | claude | none
LLM_PROVIDER="gemini"
LLM_MODEL=""
LLM_BASE_URL=""
LLM_TIMEOUT_MS="25000"
LLM_MAX_RETRIES="1"

# Generic or provider-specific server-side credentials (never expose in browser):
LLM_API_KEY=""
GEMINI_API_KEY="MY_GEMINI_API_KEY"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
